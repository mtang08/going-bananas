#!/usr/bin/env bash
# Run a command against a separate known local database without editing .env.
set -euo pipefail
source "$(dirname "$0")/env.sh"
mode="${1:?Usage: scripts/with-mode demo|real|test COMMAND ...}"
shift
case "$mode" in demo|real|test) ;; *) echo 'Invalid application mode' >&2; exit 2;; esac
export APP_MODE="$mode"
export DATABASE_URL="${DATABASE_URL%/*}/garmin_$mode"
export PRIVATE_DIR="$ROOT_DIR/private/$mode"
mkdir -p "$PRIVATE_DIR"
chmod 700 "$PRIVATE_DIR"
exec "$@"
