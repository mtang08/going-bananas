        "tags": [
          "coach"
        ],
        "summary": "Get Chat",
        "operationId": "get_chat_api_v1_coach_chat_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
