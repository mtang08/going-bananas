  "components": {
    "schemas": {
      "AppMode": {
        "type": "string",
        "enum": [
          "demo",
          "real",
          "test"
        ],
        "title": "AppMode"
      },
      "AuthInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "AuthInput"
      },
      "AuthView": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "waiting",
              "signed_out",
              "signed_in",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "default": "idle"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatProblem"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "AuthView",
        "required": [
          "status",
          "url",
          "error"
        ]
      },
      "ChatMessage": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "client_message_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Message Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "client_message_id"
        ],
        "title": "ChatMessage"
      },
      "ChatProblem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ChatProblem"
      },
      "ChatView": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "cancelled",
              "failed"
            ],
            "title": "Status"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatProblem"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposal_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          },
          "proposal_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Revision"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "messages",
          "error",
          "proposal_id",
          "proposal_revision"
        ],
        "title": "ChatView"
      },
      "Envelope_AuthView_": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version"
          },
          "data_revision": {
            "type": "integer",
            "title": "Data Revision"
          },
          "mode": {
            "$ref": "#/components/schemas/AppMode"
          },
          "data": {
            "$ref": "#/components/schemas/AuthView"
          }
        },
        "type": "object",
        "required": [
          "schema_version",
          "data_revision",
          "mode",
          "data"
        ],
        "title": "Envelope"
      },
      "Envelope_ChatView_": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version"
          },
          "data_revision": {
            "type": "integer",
            "title": "Data Revision"
          },
          "mode": {
            "$ref": "#/components/schemas/AppMode"
          },
          "data": {
            "$ref": "#/components/schemas/ChatView"
          }
        },
        "type": "object",
        "required": [
          "schema_version",
          "data_revision",
          "mode",
          "data"
        ],
        "title": "Envelope"
      },
      "MessageInput": {
        "properties": {
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Message Id"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sunday_review",
                  "today_run"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "client_message_id"
        ],
        "title": "MessageInput"
      },
      "ReviewInput": {
        "properties": {
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ReviewInput"
      },
      "ValidationField": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "ValidationField"
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationField"
            }
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id",
          "fields"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
