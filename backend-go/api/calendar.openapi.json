    },
    "/api/v1/calendar/diff": {
      "get": {
        "operationId": "getCalendarDiff",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CalendarDiff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarDiffEnvelope"
