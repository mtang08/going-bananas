          },
          "fatigue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckinMeasurement"
              },
              {
                "type": "null"
              }
            ]
          },
          "illness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "possible",
                  "present"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "gait_change": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unsure"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "pain_reported": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "context_tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckinContextTag"
            },
            "uniqueItems": true
          },
          "activity_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "symptoms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckinSymptom"
            }
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp with an explicit UTC offset."
          },
          "schema_version": {
            "type": "integer"
          },
          "exceptions": {
            "$ref": "#/components/schemas/CheckinDetection"
          }
        },
        "required": [
          "id",
          "idempotency_key",
          "version",
          "kind",
          "observed_at",
          "fatigue",
          "illness",
          "gait_change",
          "pain_reported",
          "context_tags",
          "activity_id",
          "prompt_id",
          "note",
          "symptoms",
          "recorded_at",
          "schema_version",
          "exceptions"
        ]
      },
