      "DetectedCheckin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/CheckinKind"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
